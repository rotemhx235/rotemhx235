<?xml version="1.0" encoding="utf-8"?>
<!--
  The floating button. Padding around the icon gives an oversized touch target,
  which matters for users with unsteady hands.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <ImageView
        android:id="@+id/bubble_icon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_bubble_idle"
        android:contentDescription="@string/bubble_zoom_in"
        android:padding="14dp"
        android:src="@drawable/ic_bubble_zoom" />

</FrameLayout>
