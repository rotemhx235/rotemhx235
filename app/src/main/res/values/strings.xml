    <string name="zoom_less_description">הגדלה חלשה יותר</string>
    <string name="zoom_more_description">הגדלה חזקה יותר</string>

    <!-- Font card -->
    <string name="font_title">גודל הטקסט בטלפון</string>
    <string name="font_value">%1$d%%</string>
    <string name="font_reset">חזרה לגודל הרגיל</string>
