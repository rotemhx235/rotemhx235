<resources>
    <string name="app_name">גדול</string>

    <string name="accessibility_service_description">מאפשר להגדיל את המסך בכל אפליקציה, כדי שיהיה אפשר לקרוא טקסט קטן. האפליקציה אינה אוספת ואינה שולחת שום מידע.</string>
    <string name="accessibility_service_summary">הגדלת מסך לקריאה נוחה</string>

    <!-- Magnifier card -->
    <string name="magnifier_title">הגדלת מסך</string>
    <string name="magnifier_status_on">פעיל</string>
    <string name="magnifier_status_off">כבוי</string>
    <string name="magnifier_button_turn_on">הפעלת ההגדלה</string>
    <string name="magnifier_button_turn_off">כיבוי ההגדלה</string>
    <string name="magnifier_hint_off">לחיצה על הכפתור תפתח את מסך ההגדרות של הטלפון. יש לבחור שם את ״גדול״ ולהפעיל אותו.</string>
    <string name="magnifier_hint_on">הכפתור העגול על המסך מגדיל ומקטין בלחיצה. אפשר לגרור אותו לכל מקום.</string>

